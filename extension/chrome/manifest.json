{
  "manifest_version": 3,
  "name": "Abrek Download — Video Yakalayıcı",
  "version": "1.2.2",
  "description": "İnternette gördüğünüz videoları Abrek Download'ya gönderin ve tek tıkla indirin.",
  "permissions": ["webRequest", "storage", "tabs", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrek Download — videoları yakala",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "102"
}
